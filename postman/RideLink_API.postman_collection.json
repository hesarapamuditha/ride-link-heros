{
  "info": {
    "_postman_id": "ridelink-microservices-it3130",
    "name": "RideLink Microservices API Collection",
    "description": "Comprehensive Postman test collection for RideLink 4 microservices including end-to-end positive flows and negative failure scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Account & Auth Service (Port 8081)",
      "item": [
        {
          "name": "1.1 Register Passenger Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('passengerToken', jsonData.data.token);",
                  "    pm.environment.set('passengerId', jsonData.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@ridelink.com\",\n  \"password\": \"pass1234\",\n  \"fullName\": \"Amali Fernando\",\n  \"phoneNumber\": \"+94771234567\",\n  \"role\": \"ROLE_PASSENGER\"\n}"
            },
            "url": "{{account_service_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "1.2 Login Passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('passengerToken', jsonData.data.token);",
                  "    pm.environment.set('passengerId', jsonData.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@ridelink.com\",\n  \"password\": \"pass1234\"\n}"
            },
            "url": "{{account_service_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "1.3 Register Driver User Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('driverToken', jsonData.data.token);",
                  "    pm.environment.set('driverUserId', jsonData.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@ridelink.com\",\n  \"password\": \"drive1234\",\n  \"fullName\": \"Kasun Bandara\",\n  \"phoneNumber\": \"+94779876543\",\n  \"role\": \"ROLE_DRIVER\"\n}"
            },
            "url": "{{account_service_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "1.4 Negative: Login with Wrong Password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@ridelink.com\",\n  \"password\": \"wrongPassword123\"\n}"
            },
            "url": "{{account_service_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "1.5 Negative: Duplicate Email Registration (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@ridelink.com\",\n  \"password\": \"pass1234\",\n  \"fullName\": \"Duplicate User\",\n  \"phoneNumber\": \"+94779998888\",\n  \"role\": \"ROLE_PASSENGER\"\n}"
            },
            "url": "{{account_service_url}}/api/v1/auth/register"
          }
        }
      ]
    },
    {
      "name": "02 - Driver & Vehicle Service (My Part - Port 8082)",
      "item": [
        {
          "name": "2.1 Register Driver Operational Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('driverId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{driverUserId}}\",\n  \"fullName\": \"Kasun Bandara\",\n  \"email\": \"kasun.driver@ridelink.com\",\n  \"phoneNumber\": \"+94779876543\",\n  \"licenseNumber\": \"B-8839201\",\n  \"yearsOfExperience\": 6,\n  \"serviceCity\": \"Colombo\",\n  \"operatingRadiusKm\": 20.0\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers"
          }
        },
        {
          "name": "2.2 Admin Verify Driver Profile",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/verify?status=VERIFIED",
              "host": ["{{driver_service_url}}"],
              "path": ["api", "v1", "drivers", "{{driverId}}", "verify"],
              "query": [{ "key": "status", "value": "VERIFIED" }]
            }
          }
        },
        {
          "name": "2.3 Register Vehicle for Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('vehicleId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Prius\",\n  \"year\": 2021,\n  \"plateNumber\": \"WP-CAD-7890\",\n  \"color\": \"Pearl White\",\n  \"vehicleType\": \"CAR\",\n  \"seatingCapacity\": 4\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/vehicles"
          }
        },
        {
          "name": "2.4 Update Driver Simulated Location",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 6.9344,\n  \"longitude\": 79.8428,\n  \"addressName\": \"Fort Railway Station, Colombo 01\"\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/location"
          }
        },
        {
          "name": "2.5 Update Driver Availability to AVAILABLE",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/availability"
          }
        },
        {
          "name": "2.6 Interservice Endpoint: Query Eligible Drivers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{driver_service_url}}/api/v1/drivers/eligible?pickupLat=6.9300&pickupLng=79.8450&vehicleType=CAR&radiusKm=10&limit=5",
              "host": ["{{driver_service_url}}"],
              "path": ["api", "v1", "drivers", "eligible"],
              "query": [
                { "key": "pickupLat", "value": "6.9300" },
                { "key": "pickupLng", "value": "79.8450" },
                { "key": "vehicleType", "value": "CAR" },
                { "key": "radiusKm", "value": "10" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "2.7 Rate Driver",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5.0,\n  \"comment\": \"Smooth and safe drive!\"\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/rate"
          }
        },
        {
          "name": "2.8 Negative: Duplicate Vehicle Plate (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Honda\",\n  \"model\": \"Civic\",\n  \"year\": 2020,\n  \"plateNumber\": \"WP-CAD-7890\",\n  \"color\": \"Black\",\n  \"vehicleType\": \"CAR\",\n  \"seatingCapacity\": 4\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/vehicles"
          }
        },
        {
          "name": "2.9 Negative: Invalid Latitude Bounds > 90 (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 999.0,\n  \"longitude\": 79.8428,\n  \"addressName\": \"Invalid Latitude\"\n}"
            },
            "url": "{{driver_service_url}}/api/v1/drivers/{{driverId}}/location"
          }
        }
      ]
    },
    {
      "name": "03 - Ride Management Service (Port 8083)",
      "item": [
        {
          "name": "3.1 Request a Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('rideId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"{{passengerId}}\",\n  \"pickupLocation\": {\n    \"name\": \"Fort, Colombo 01\",\n    \"latitude\": 6.9344,\n    \"longitude\": 79.8428\n  },\n  \"destinationLocation\": {\n    \"name\": \"Bambalapitiya, Colombo 04\",\n    \"latitude\": 6.8969,\n    \"longitude\": 79.8573\n  },\n  \"vehicleType\": \"CAR\"\n}"
            },
            "url": "{{ride_service_url}}/api/v1/rides/request"
          }
        },
        {
          "name": "3.2 Assign Nearest Driver (Interservice)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{ride_service_url}}/api/v1/rides/{{rideId}}/assign-driver"
          }
        },
        {
          "name": "3.3 Driver Accepts Ride",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{ride_service_url}}/api/v1/rides/{{rideId}}/accept"
          }
        },
        {
          "name": "3.4 Driver Starts Trip",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{ride_service_url}}/api/v1/rides/{{rideId}}/start"
          }
        },
        {
          "name": "3.5 Driver Completes Trip (Triggers Interservice Payment)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{ride_service_url}}/api/v1/rides/{{rideId}}/complete"
          }
        },
        {
          "name": "3.6 Negative: Invalid State Transition (Complete before Start) (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{ride_service_url}}/api/v1/rides/{{rideId}}/start"
          }
        }
      ]
    },
    {
      "name": "04 - Fare & Payment Service (Port 8084)",
      "item": [
        {
          "name": "4.1 Calculate Fare Estimate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLat\": 6.9344,\n  \"pickupLng\": 79.8428,\n  \"destLat\": 6.8969,\n  \"destLng\": 79.8573,\n  \"vehicleType\": \"CAR\",\n  \"trafficMultiplier\": 1.15\n}"
            },
            "url": "{{fare_service_url}}/api/v1/fares/estimate"
          }
        },
        {
          "name": "4.2 Process Simulated Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 550.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardNumber\": \"4532123456789010\"\n}"
            },
            "url": "{{fare_service_url}}/api/v1/payments/process"
          }
        },
        {
          "name": "4.3 Negative: Simulated Declined Card Ending in 0000 (402)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 402 Payment Required', function () { pm.response.to.have.status(402); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"ride-negative-test\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 550.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardNumber\": \"4532123456780000\"\n}"
            },
            "url": "{{fare_service_url}}/api/v1/payments/process"
          }
        },
        {
          "name": "4.4 Get Receipt by Ride ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{fare_service_url}}/api/v1/payments/receipts/ride/{{rideId}}"
          }
        }
      ]
    }
  ]
}
